# TRUST AI — variables d'environnement.
# L'application fonctionne et se compile SANS AUCUNE de ces variables
# (mode démonstration). Ne jamais mettre de vraies valeurs dans ce fichier.

# URL publique de l'application
NEXT_PUBLIC_APP_URL=

# ---------------------------------------------------------------------------
# Supabase — mode connecté (voir docs/SUPABASE_SETUP.md)
# Seules ces DEUX clés publiques sont nécessaires côté application.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# IMPORTANT — ne JAMAIS ajouter ici ni committer :
#  * une secret key ou service role key Supabase ;
#  * une URL directe Postgres ou un mot de passe de base de données ;
#  * une clé API quelconque.
# Les opérations administratives nécessitant un secret serveur ne sont pas
# encore implémentées : elles seront ajoutées plus tard, côté serveur
# uniquement, jamais exposées au navigateur.

# ---------------------------------------------------------------------------
# Shopify (réception des commandes par webhook — phase suivante)
# ---------------------------------------------------------------------------
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_WEBHOOK_SECRET=

# OpenAI (agent IA : propositions fournisseurs, relances, alertes — phase suivante)
OPENAI_API_KEY=
