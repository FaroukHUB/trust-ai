# TRUST AI — variables d'environnement (aucune n'est requise pour la démo).
# L'application fonctionne et se compile sans aucune de ces variables.
# Ne jamais mettre de vraies valeurs dans ce fichier.

# URL publique de l'application
NEXT_PUBLIC_APP_URL=

# Supabase (stockage des données — phase 2)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé serveur uniquement : ne jamais l'exposer dans le navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# Shopify (réception des commandes par webhook — phase 2)
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_WEBHOOK_SECRET=

# OpenAI (agent IA : propositions fournisseurs, relances, alertes — phase 2)
OPENAI_API_KEY=
